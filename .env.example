# Copy to .env and fill in your values (never commit .env).
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=rxsentinel
# Gemini key for web_verify.py (web-search fallback) and Phase 3 OCR.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any OpenAI-compatible provider instead of Gemini (free-tier fallback):
# OpenRouter, Groq, DeepSeek, local Ollama / LM Studio, ...
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Dedicated handwriting (vision) wiring — SEPARATE from the web-check LLM
# above, because the vision model must accept images and the web-check
# model may be text-only. Falls back to the LLM_* lines when unset, then
# to native Gemini (GEMINI_API_KEY). For a local LM Studio / Ollama
# server any non-empty key works, e.g. VISION_API_KEY=local.
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_API_KEY=
# VISION_MODEL=google/gemini-2.5-flash
# Phase 4 admin password for the review queue (X-Admin-Password header).
# DEMO-GRADE protection for a course project only: a single shared
# password, no per-user accounts, no rate limiting. Do NOT use a
# password you use anywhere else, and do not treat this as production
# auth. The API fails closed (401) when this is unset.
ADMIN_PASSWORD=admin
# Phase 4 document chat embeddings: the model for the OpenAI-compatible
# /embeddings endpoint at LLM_BASE_URL above (e.g. for OpenRouter,
# "openai/text-embedding-3-small"; for a local Ollama server, the
# embedding model you pulled, e.g. "nomic-embed-text"). If LLM_BASE_URL
# + EMBEDDING_MODEL are unset, the chat falls back to a local
# sentence-transformers model ONLY if it is installed; otherwise chat
# returns a clear error instead of a made-up answer.
EMBEDDING_MODEL=
